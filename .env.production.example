# With a domain, use the same HTTPS URL for both values.
SITE_ADDRESS=soundpad.example.com, www.soundpad.example.com
SECONDARY_DOMAIN=www.soundpad.example.com
PUBLIC_BASE_URL=https://soundpad.example.com
SECURE_COOKIES=true

# Use URL-safe characters for the database password (letters and digits are simplest).
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
YOUTUBE_TEMP_TTL_HOURS=24
