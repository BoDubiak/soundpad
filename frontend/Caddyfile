{$SITE_ADDRESS} {
	encode zstd gzip

	@secondary host {$SECONDARY_DOMAIN:secondary.invalid}
	redir @secondary {$PUBLIC_BASE_URL}{uri} permanent

	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
