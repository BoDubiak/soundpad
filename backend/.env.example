DATABASE_URL=postgresql+psycopg://soundpad:soundpad@localhost:55432/soundpad
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=soundpad_refresh_token
SECURE_COOKIES=false
YOUTUBE_TEMP_TTL_HOURS=24
# For YouTube bot checks, prefer an exported Netscape cookies.txt file.
# YOUTUBE_COOKIES_FILE=C:/path/to/youtube-cookies.txt
# Local development alternative (for example: chrome, edge, or firefox):
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
# Optional local PO Token Provider endpoint:
# YOUTUBE_PO_TOKEN_PROVIDER_URL=http://localhost:4416
# Optional HTTP(S) or SOCKS proxy for YouTube requests:
# YOUTUBE_PROXY_URL=http://username:password@proxy.example.com:8080
